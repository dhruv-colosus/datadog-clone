# Container registry (GHCR) — lowercase GitHub username/org
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_random
POSTGRES_DB=datadogdb

# Backend (FastAPI) — connects to the `db` service on the compose network
DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong_random@db:5432/datadogdb

# JWT
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Password policy
PASSWORD_MIN_LENGTH=8

# Public URLs / cookies
FRONTEND_URL=https://datadog.dhruvdeora.com
COOKIE_DOMAIN=datadog.dhruvdeora.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Local-only test-login bypass — keep TEST_AUTH_ENABLED=false in production.
# When true, POST /auth/test-login issues a session cookie for TEST_AUTH_EMAIL
# without password verification. Flipped on by docker-compose.fresh.yml.
TEST_AUTH_ENABLED=false
TEST_AUTH_EMAIL=playwright-e2e@example.com
TEST_AUTH_NAME=Playwright Test

# Admin endpoints (POST /admin/reset, POST /admin/seed, POST /admin/inject-spike,
# POST /admin/clear-telemetry, POST /admin/backfill, POST /admin/reseed-topology).
# Leave unset/empty in production to make /admin/* return 404. When set, callers
# must send the value in the X-Admin-Key header.
ADMIN_API_KEY=

# Telemetry seed generator
# When true, the API runs a one-shot 7-day backfill on boot if metric_points is empty.
# Disable in production. In dev, lower BACKFILL_DAYS (e.g. 1) for faster iteration.
BACKFILL_ON_BOOT=true
BACKFILL_DAYS=7
# Generator tick interval (seconds). 60 = one tick per minute (recommended).
TICK_INTERVAL_SECONDS=60
# Kill switch — when false, the runner + spike injector tasks don't start.
GENERATOR_ENABLED=true
# Fraction of (metric, host) series emitted per tick. 0.05 → each series
# emits roughly every 20 ticks (every 20 minutes at the default tick).
METRIC_SAMPLE_RATE=0.05
# Multipliers on the per-service log + trace rates. Lower = quieter.
LOG_RATE_FACTOR=0.05
TRACE_RATE_FACTOR=0.05
