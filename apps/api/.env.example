DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/datadogdb
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

PASSWORD_MIN_LENGTH=8

FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Playwright e2e tests: set to true ONLY in local/test envs.
# Enables POST /auth/test-login which issues a JWT cookie for a seeded test user
# without password verification. Must stay false in production.
TEST_AUTH_ENABLED=false
TEST_AUTH_EMAIL=playwright-e2e@example.com
TEST_AUTH_NAME=Playwright Test
